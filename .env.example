# Committed template for local setup — copy to .env.local and fill secrets.
# See web.development.example, web.staging.example, web.production.example for full env sets.

LUXOR_ENV=development
NEXT_PUBLIC_LUXOR_ENV=development

# Frontend-only mode: merchant data (links, products, customers, payments) uses browser localStorage.
# Login/session still requires Firebase Authentication (see NEXT_PUBLIC_FIREBASE_* below).
NEXT_PUBLIC_FRONTEND_ONLY=true

# External Node API — disabled by default. Set NEXT_PUBLIC_FRONTEND_ONLY=false and uncomment:
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Firebase Authentication (required for login/session — merchant data stays in localStorage)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Solana cluster: mainnet-beta | devnet | testnet
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
# Custom RPC (recommended for production). Devnet example:
# NEXT_PUBLIC_SOLANA_NETWORK=devnet
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
