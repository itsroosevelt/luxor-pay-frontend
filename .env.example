# Committed template for local setup — copy to .env.local and fill secrets.
# Full local variable set: web.development.example in the repo root.
# Staging/production: web.staging.example, web.production.example (repo root).

LUXOR_ENV=development
NEXT_PUBLIC_LUXOR_ENV=development

# Backend: luxor-pay-be-solana (luxor-payment-service). Set FRONTEND_ONLY=true to skip API (local demo).
NEXT_PUBLIC_API_PROXY=true
NEXT_PUBLIC_API_URL=http://localhost:3008
# NEXT_PUBLIC_FRONTEND_ONLY=true

# Firebase Authentication (required for login/session — merchant data stays in localStorage)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Solana cluster: mainnet-beta | devnet | testnet
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
# Custom RPC (recommended for production). Devnet example:
# NEXT_PUBLIC_SOLANA_NETWORK=devnet
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
